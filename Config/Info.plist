<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Moodle's launch.php redirects to moodlemobile://token=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.jayansh.UniversityPortal.moodle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moodlemobile</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<!-- Sparkle: updates from the latest GitHub release's appcast.xml, signed with this EdDSA key
	     (private key in the maintainer's Keychain, account "university-portal"). -->
	<key>SUFeedURL</key>
	<string>https://github.com/JayanshJ/university-portal/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>6397nvhsGBFmxTVo6LXmwrl007sFscmBSfFjOwZOWuY=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- The sandboxed app hands installation to Sparkle's installer service. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
